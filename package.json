{
  "name": "parabank-playwright",
  "version": "1.0.0",
  "description": "End-to-end test automation framework using Playwright and TypeScript",
  "main": "index.js",
  "scripts": {
    "test:api": "playwright test --config=playwright.api.config.ts",
    "test:registration": "playwright test --config=playwright.registration.config.ts --timeout=90000",
    "test:regression": "playwright test --config=playwright.login.config.ts --grep \"@regression\"",
    "test:regression:all": "playwright test --config=playwright.login.config.ts --grep \"@regression\" --workers=3 --timeout=90000",
    "test:report": "playwright show-report"
  },
  "keywords": [
    "playwright",
    "typescript",
    "test-automation",
    "qa",
    "api-testing",
    "e2e-testing"
  ],
  "author": "Terry Kariuki",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15"
  },
  "dependencies": {
    "dotenv": "^18.0.10"
  }
}